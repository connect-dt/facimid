/* ================= APP STATE ================= */
const state={
  id: shuffle(ID_BANK.slice()),
  mcq: shuffle(MCQ_BANK.slice()).map(item=>({q:item[0],choices:shuffle(item[1].slice()),answer:item[2]})),
  fib: shuffle(FIB_BANK.slice()),
  enum: shuffle(ENUM_BANK.slice()).map(item=>({q:item[0],options:shuffle(item[1].slice()),correct:item[2]})),
  acr: shuffle(ACR_BANK.slice()).map(item=>({q:item[0],choices:shuffle(item[1].slice()),answer:item[2]})),
  ismid: shuffle(ISM_ID_BANK.slice()),
  ismmcq: shuffle(ISM_MCQ_BANK.slice()).map(item=>({q:item[0],choices:shuffle(item[1].slice()),answer:item[2]}))
};

const SECTIONS=[
  {key:"id",title:"Test I — Identification",sub:"Identify the term being described. Write your answer in the box.",count:state.id.length},
  {key:"mcq",title:"Test II — Multiple Choice",sub:"Choose the letter of the best answer.",count:state.mcq.length},
  {key:"fib",title:"Test III — Fill in the Blank",sub:"Complete each sentence with the correct word or phrase.",count:state.fib.length},
  {key:"enum",title:"Test IV — Enumeration",sub:"Check all options that correctly answer each prompt.",count:state.enum.length},
  {key:"acr",title:"Test V — Acronyms",sub:"Choose what each acronym or abbreviation stands for.",count:state.acr.length},
  {key:"isms",title:"Test VI — Isms of Education",sub:"Identify the -ism, or choose the best answer about its proponents and examples.",count:state.ismid.length+state.ismmcq.length}
];

let currentPage=0;
let submitted=false;

/* ================= RENDER ================= */
const pagesEl=document.getElementById("pages");
const dotsEl=document.getElementById("progressDots");

function buildPages(){
  pagesEl.innerHTML="";
  dotsEl.innerHTML="";
  SECTIONS.forEach((sec,pi)=>{
    const div=document.createElement("div");
    div.className="page"+(pi===0?" visible":"");
    div.id="page-"+pi;
    let html=`<div class="section-title">${sec.title}</div><div class="section-sub">${sec.sub} (${sec.count} items)</div>`;

    if(sec.key==="id"){
      state.id.forEach((item,i)=>{
        html+=`<div class="q" id="q-id-${i}"><div class="qtext"><span class="num">${i+1}.</span>${item[0]}</div><input type="text" data-sec="id" data-i="${i}" placeholder="Your answer"><div class="correction" id="corr-id-${i}"></div></div>`;
      });
    } else if(sec.key==="mcq"){
      state.mcq.forEach((item,i)=>{
        html+=`<div class="q" id="q-mcq-${i}"><div class="qtext"><span class="num">${i+1}.</span>${item.q}</div>`;
        const letters=["A","B","C","D"];
        item.choices.forEach((c,ci)=>{
          html+=`<label class="opt" id="opt-mcq-${i}-${ci}"><input type="radio" name="mcq-${i}" value="${c.replace(/"/g,'&quot;')}" data-sec="mcq" data-i="${i}"> <span>${letters[ci]}. ${c}</span></label>`;
        });
        html+=`<div class="correction" id="corr-mcq-${i}"></div></div>`;
      });
    } else if(sec.key==="fib"){
      state.fib.forEach((item,i)=>{
        html+=`<div class="q" id="q-fib-${i}"><div class="qtext"><span class="num">${i+1}.</span>${item[0]}</div><input type="text" data-sec="fib" data-i="${i}" placeholder="Your answer"><div class="correction" id="corr-fib-${i}"></div></div>`;
      });
    } else if(sec.key==="enum"){
      state.enum.forEach((item,i)=>{
        html+=`<div class="q" id="q-enum-${i}"><div class="qtext"><span class="num">${i+1}.</span>${item.q}</div>`;
        item.options.forEach((o,oi)=>{
          html+=`<label class="opt" id="opt-enum-${i}-${oi}"><input type="checkbox" value="${o.replace(/"/g,'&quot;')}" data-sec="enum" data-i="${i}"> <span>${o}</span></label>`;
        });
        html+=`<div class="correction" id="corr-enum-${i}"></div></div>`;
      });
    } else if(sec.key==="acr"){
      state.acr.forEach((item,i)=>{
        html+=`<div class="q" id="q-acr-${i}"><div class="qtext"><span class="num">${i+1}.</span>${item.q}</div>`;
        const letters=["A","B","C","D"];
        item.choices.forEach((c,ci)=>{
          html+=`<label class="opt" id="opt-acr-${i}-${ci}"><input type="radio" name="acr-${i}" value="${c.replace(/"/g,'&quot;')}" data-sec="acr" data-i="${i}"> <span>${letters[ci]}. ${c}</span></label>`;
        });
        html+=`<div class="correction" id="corr-acr-${i}"></div></div>`;
      });
    } else if(sec.key==="isms"){
      let n=0;
      state.ismid.forEach((item,i)=>{
        n++;
        html+=`<div class="q" id="q-ismid-${i}"><div class="qtext"><span class="num">${n}.</span>${item[0]}</div><input type="text" data-sec="ismid" data-i="${i}" placeholder="Your answer"><div class="correction" id="corr-ismid-${i}"></div></div>`;
      });
      state.ismmcq.forEach((item,i)=>{
        n++;
        html+=`<div class="q" id="q-ismmcq-${i}"><div class="qtext"><span class="num">${n}.</span>${item.q}</div>`;
        const letters=["A","B","C","D"];
        item.choices.forEach((c,ci)=>{
          html+=`<label class="opt" id="opt-ismmcq-${i}-${ci}"><input type="radio" name="ismmcq-${i}" value="${c.replace(/"/g,'&quot;')}" data-sec="ismmcq" data-i="${i}"> <span>${letters[ci]}. ${c}</span></label>`;
        });
        html+=`<div class="correction" id="corr-ismmcq-${i}"></div></div>`;
      });
    }
    div.innerHTML=html;
    pagesEl.appendChild(div);

    const dot=document.createElement("div");
    dot.className="dot"+(pi===0?" active":"");
    dot.id="dot-"+pi;
    dotsEl.appendChild(dot);
  });
}

function showPage(n){
  document.querySelectorAll(".page").forEach((p,i)=>p.classList.toggle("visible",i===n));
  document.querySelectorAll(".dot").forEach((d,i)=>d.classList.toggle("active",i===n));
  currentPage=n;
  document.getElementById("prevBtn").disabled=(n===0);
  const isLast=(n===SECTIONS.length-1);
  document.getElementById("nextBtn").style.display=isLast?"none":"inline-block";
  document.getElementById("submitBtn").style.display=(isLast&&!submitted)?"inline-block":"none";
  document.getElementById("pageCount").textContent="Page "+(n+1)+" of "+SECTIONS.length+" — "+SECTIONS[n].title;
  window.scrollTo({top:0,behavior:"smooth"});
}

document.getElementById("prevBtn").addEventListener("click",()=>{if(currentPage>0)showPage(currentPage-1);});
document.getElementById("nextBtn").addEventListener("click",()=>{if(currentPage<SECTIONS.length-1)showPage(currentPage+1);});

/* ================= GRADING ================= */
function gradeExam(){
  submitted=true;
  let totalScore=0, totalItems=0;
  const bySection={};

  // ID
  let idCorrect=0;
  state.id.forEach((item,i)=>{
    const inputEl=document.querySelector(`input[data-sec="id"][data-i="${i}"]`);
    const userVal=inputEl?inputEl.value:"";
    const ok=norm(userVal)===norm(item[1]);
    const box=document.getElementById("q-id-"+i);
    box.classList.add(ok?"correct":"incorrect");
    box.classList.add("answered");
    if(!ok){
      const c=document.getElementById("corr-id-"+i);
      c.textContent="Correct answer: "+item[1];
      c.classList.add("show");
    }
    if(ok)idCorrect++;
  });
  bySection["Test I — Identification"]=[idCorrect,state.id.length];
  totalScore+=idCorrect; totalItems+=state.id.length;

  // MCQ
  let mcqCorrect=0;
  state.mcq.forEach((item,i)=>{
    const sel=document.querySelector(`input[name="mcq-${i}"]:checked`);
    const userVal=sel?sel.value:null;
    const ok=userVal===item.answer;
    const box=document.getElementById("q-mcq-"+i);
    box.classList.add(ok?"correct":"incorrect");
    box.classList.add("answered");
    item.choices.forEach((c,ci)=>{
      const optEl=document.getElementById(`opt-mcq-${i}-${ci}`);
      if(c===item.answer)optEl.classList.add("correctopt");
      else if(c===userVal)optEl.classList.add("incorrectopt");
    });
    if(!ok){
      const c=document.getElementById("corr-mcq-"+i);
      c.textContent="Correct answer: "+item.answer;
      c.classList.add("show");
    }
    if(ok)mcqCorrect++;
  });
  bySection["Test II — Multiple Choice"]=[mcqCorrect,state.mcq.length];
  totalScore+=mcqCorrect; totalItems+=state.mcq.length;

  // FIB
  let fibCorrect=0;
  state.fib.forEach((item,i)=>{
    const inputEl=document.querySelector(`input[data-sec="fib"][data-i="${i}"]`);
    const userVal=inputEl?inputEl.value:"";
    const ok=norm(userVal)===norm(item[1]);
    const box=document.getElementById("q-fib-"+i);
    box.classList.add(ok?"correct":"incorrect");
    box.classList.add("answered");
    if(!ok){
      const c=document.getElementById("corr-fib-"+i);
      c.textContent="Correct answer: "+item[1];
      c.classList.add("show");
    }
    if(ok)fibCorrect++;
  });
  bySection["Test III — Fill in the Blank"]=[fibCorrect,state.fib.length];
  totalScore+=fibCorrect; totalItems+=state.fib.length;

  // ENUM (partial credit disabled -> whole item correct only if exact set match)
  let enumCorrect=0;
  state.enum.forEach((item,i)=>{
    const checks=document.querySelectorAll(`input[data-sec="enum"][data-i="${i}"]:checked`);
    const userSet=Array.from(checks).map(c=>c.value);
    const correctSet=item.correct;
    const ok=userSet.length===correctSet.length && userSet.every(v=>correctSet.includes(v));
    const box=document.getElementById("q-enum-"+i);
    box.classList.add(ok?"correct":"incorrect");
    box.classList.add("answered");
    item.options.forEach((o,oi)=>{
      const optEl=document.getElementById(`opt-enum-${i}-${oi}`);
      if(correctSet.includes(o))optEl.classList.add("correctopt");
      else if(userSet.includes(o))optEl.classList.add("incorrectopt");
    });
    if(!ok){
      const c=document.getElementById("corr-enum-"+i);
      c.textContent="Correct selections: "+correctSet.join(", ");
      c.classList.add("show");
    }
    if(ok)enumCorrect++;
  });
  bySection["Test IV — Enumeration"]=[enumCorrect,state.enum.length];
  totalScore+=enumCorrect; totalItems+=state.enum.length;

  // ACR
  let acrCorrect=0;
  state.acr.forEach((item,i)=>{
    const sel=document.querySelector(`input[name="acr-${i}"]:checked`);
    const userVal=sel?sel.value:null;
    const ok=userVal===item.answer;
    const box=document.getElementById("q-acr-"+i);
    box.classList.add(ok?"correct":"incorrect");
    box.classList.add("answered");
    item.choices.forEach((c,ci)=>{
      const optEl=document.getElementById(`opt-acr-${i}-${ci}`);
      if(c===item.answer)optEl.classList.add("correctopt");
      else if(c===userVal)optEl.classList.add("incorrectopt");
    });
    if(!ok){
      const c=document.getElementById("corr-acr-"+i);
      c.textContent="Correct answer: "+item.answer;
      c.classList.add("show");
    }
    if(ok)acrCorrect++;
  });
  bySection["Test V — Acronyms"]=[acrCorrect,state.acr.length];
  totalScore+=acrCorrect; totalItems+=state.acr.length;

  // ISMS (identification part)
  let ismCorrect=0;
  state.ismid.forEach((item,i)=>{
    const inputEl=document.querySelector(`input[data-sec="ismid"][data-i="${i}"]`);
    const userVal=inputEl?inputEl.value:"";
    const ok=norm(userVal)===norm(item[1]);
    const box=document.getElementById("q-ismid-"+i);
    box.classList.add(ok?"correct":"incorrect");
    box.classList.add("answered");
    if(!ok){
      const c=document.getElementById("corr-ismid-"+i);
      c.textContent="Correct answer: "+item[1];
      c.classList.add("show");
    }
    if(ok)ismCorrect++;
  });
  // ISMS (mcq part)
  state.ismmcq.forEach((item,i)=>{
    const sel=document.querySelector(`input[name="ismmcq-${i}"]:checked`);
    const userVal=sel?sel.value:null;
    const ok=userVal===item.answer;
    const box=document.getElementById("q-ismmcq-"+i);
    box.classList.add(ok?"correct":"incorrect");
    box.classList.add("answered");
    item.choices.forEach((c,ci)=>{
      const optEl=document.getElementById(`opt-ismmcq-${i}-${ci}`);
      if(c===item.answer)optEl.classList.add("correctopt");
      else if(c===userVal)optEl.classList.add("incorrectopt");
    });
    if(!ok){
      const c=document.getElementById("corr-ismmcq-"+i);
      c.textContent="Correct answer: "+item.answer;
      c.classList.add("show");
    }
    if(ok)ismCorrect++;
  });
  const ismTotal=state.ismid.length+state.ismmcq.length;
  bySection["Test VI — Isms of Education"]=[ismCorrect,ismTotal];
  totalScore+=ismCorrect; totalItems+=ismTotal;

  // disable all inputs
  document.querySelectorAll("input").forEach(inp=>inp.disabled=true);

  // show summary
  const summaryBox=document.getElementById("summaryBox");
  document.getElementById("totalScore").textContent=totalScore+" / "+totalItems;
  document.getElementById("totalPct").textContent=Math.round((totalScore/totalItems)*100)+"% overall";
  const bd=document.getElementById("breakdown");
  bd.innerHTML="";
  Object.keys(bySection).forEach(k=>{
    const [c,t]=bySection[k];
    const row=document.createElement("div");
    row.innerHTML=`${k} <span>${c} / ${t}</span>`;
    bd.appendChild(row);
  });
  summaryBox.classList.add("visible");

  // reveal all pages for review
  document.querySelectorAll(".page").forEach(p=>p.classList.add("visible"));
  document.getElementById("prevBtn").style.display="none";
  document.getElementById("nextBtn").style.display="none";
  document.getElementById("submitBtn").style.display="none";
  document.getElementById("pageCount").textContent="Review — all pages shown below";
  window.scrollTo({top:0,behavior:"smooth"});
}

document.getElementById("submitBtn").addEventListener("click",()=>{
  if(confirm("Submit the full exam? You won't be able to change your answers after this.")){
    gradeExam();
  }
});

buildPages();
showPage(0);
</script>

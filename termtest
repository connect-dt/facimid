<title>Facilitating Learner-Centered Teaching — Comprehensive Exam (Lessons 5-13)</title>
<style>
:root{
  --paper:#f4ecd8;
  --paper2:#ece0c4;
  --ink:#3b2a1a;
  --ink-soft:#5c4630;
  --rule:#c8b389;
  --accent:#7a3b1e;
  --accent2:#9c6b2e;
  --good-bg:#d7ead0;
  --good-bd:#5f8f4e;
  --bad-bg:#f3d6d0;
  --bad-bd:#a8402c;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--paper2);
  color:var(--ink);
  font-family:Georgia,'Iowan Old Style','Palatino Linotype',serif;
  line-height:1.5;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
.wrap{max-width:760px;margin:0 auto;padding:18px 16px 60px;}
.letterhead{
  background:var(--paper);
  border:1px solid var(--rule);
  border-radius:2px;
  padding:22px 24px;
  margin-bottom:14px;
  box-shadow:0 1px 0 var(--rule);
}
.letterhead h1{
  font-size:1.35rem;
  margin:0 0 4px;
  color:var(--accent);
  font-weight:700;
  letter-spacing:.2px;
}
.letterhead p{margin:2px 0;color:var(--ink-soft);font-size:.92rem;}
.rule{border:none;border-top:2px solid var(--accent2);margin:12px 0;}
.name-line{margin-top:14px;font-size:.92rem;color:var(--ink-soft);}
.name-line input{
  border:none;border-bottom:1px solid var(--ink-soft);
  background:transparent;font-family:inherit;font-size:.95rem;
  color:var(--ink);padding:2px 4px;width:220px;
}
.progress{
  display:flex;gap:4px;margin:10px 0 4px;flex-wrap:wrap;
}
.dot{
  flex:1;min-width:18px;height:6px;background:var(--rule);border-radius:3px;
}
.dot.active{background:var(--accent);}
.page{
  background:var(--paper);
  border:1px solid var(--rule);
  border-radius:2px;
  padding:22px 24px;
  display:none;
}
.page.visible{display:block;}
.section-title{
  color:var(--accent);
  font-size:1.05rem;
  margin:0 0 2px;
  font-weight:700;
}
.section-sub{color:var(--ink-soft);font-size:.85rem;margin:0 0 16px;font-style:italic;}
.q{
  margin-bottom:16px;
  padding:12px 14px;
  border:1px solid var(--rule);
  border-radius:2px;
  background:rgba(255,255,255,.35);
}
.q .num{font-weight:700;color:var(--accent);margin-right:6px;}
.q .qtext{margin-bottom:8px;}
.q input[type=text]{
  width:100%;
  padding:7px 8px;
  border:1px solid var(--ink-soft);
  border-radius:2px;
  background:#fffdf7;
  font-family:inherit;
  font-size:.95rem;
  color:var(--ink);
}
.opt{
  display:flex;align-items:flex-start;gap:8px;
  padding:5px 6px;border-radius:2px;cursor:pointer;
  font-size:.94rem;
}
.opt:hover{background:rgba(122,59,30,.06);}
.opt input{margin-top:3px;}
.nav{
  display:flex;justify-content:space-between;align-items:center;
  margin-top:16px;gap:10px;
}
button{
  font-family:inherit;
  background:var(--accent);
  color:#fbf3e2;
  border:none;
  padding:10px 18px;
  border-radius:2px;
  font-size:.92rem;
  cursor:pointer;
}
button:disabled{opacity:.4;cursor:not-allowed;}
button.secondary{background:transparent;color:var(--accent);border:1px solid var(--accent);}
button.submit{background:var(--accent2);}
.pagecount{color:var(--ink-soft);font-size:.85rem;}
.summary{
  display:none;
  background:var(--paper);
  border:2px solid var(--accent);
  border-radius:2px;
  padding:20px 22px;
  margin-bottom:16px;
}
.summary.visible{display:block;}
.summary h2{margin:0 0 8px;color:var(--accent);font-size:1.15rem;}
.summary .total{font-size:1.6rem;font-weight:700;color:var(--accent);}
.breakdown{display:grid;grid-template-columns:1fr 1fr;gap:6px 18px;margin-top:12px;font-size:.9rem;}
.breakdown div span{float:right;color:var(--ink-soft);}
.answered.correct{background:var(--good-bg)!important;border-color:var(--good-bd)!important;}
.answered.incorrect{background:var(--bad-bg)!important;border-color:var(--bad-bd)!important;}
.correction{
  margin-top:8px;font-size:.85rem;color:var(--accent);font-style:italic;display:none;
}
.correction.show{display:block;}
.opt.correctopt{background:var(--good-bg);}
.opt.incorrectopt{background:var(--bad-bg);}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#2a2116; --paper2:#1c1610; --ink:#ecdfc4; --ink-soft:#c6b28c;
    --rule:#5a4a30; --accent:#e0a36b; --accent2:#d8bd7f;
    --good-bg:#2e3e26; --good-bd:#6fae52; --bad-bg:#402620; --bad-bd:#c05c40;
  }
  input[type=text]{background:#241d13!important;color:#ecdfc4!important;}
}
:root[data-theme="dark"]{
  --paper:#2a2116; --paper2:#1c1610; --ink:#ecdfc4; --ink-soft:#c6b28c;
